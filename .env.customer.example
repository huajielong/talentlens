# Keep existing model keys on the server; never commit .env.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com
GITHUB_TOKEN=
NODE_ENV=production
DOMAIN=talentlens.example.com
PUBLIC_URL=https://talentlens.example.com
TALENTLENS_SETUP_TOKEN=
PORT=4173
# HOST stays loopback for native deployment behind a same-machine HTTPS proxy.
HOST=127.0.0.1
